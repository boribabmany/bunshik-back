# ── Database ─────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/your_database?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ── JWT (관리자 로그인 토큰) ─────────────────
# 운영에서는 반드시 무작위 문자열로 교체할 것
JWT_SECRET=replace_with_a_secure_random_secret
# 토큰 만료 시간 (ms). 기본 1시간
JWT_EXPIRATION=3600000

# ── 토스페이먼츠 결제 승인 API ───────────────
# 토스 개발자센터 > 내 개발정보 > 시크릿 키
TOSS_SECRET_KEY=your_toss_secret_key